---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import Why from '../components/Why.astro'
import Metrics from '../components/Metrics.astro'
import Features from '../components/Features.astro'
import Footer from '../components/Footer.astro'
import { hero } from '../data/hero'
import { DOCS_URL, REPO } from '../data/site'

const title = `jsrt | ${hero.headline.replace(/\.$/, '')}`
const description =
  'jsrt is a purpose-built JavaScript host in Rust: V8 through deno_core, Rust owning deny-by-default capabilities, lifecycle and honest errors.'
---

<Base
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'jsrt',
      url: Astro.site?.href,
      description,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'jsrt',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS',
      softwareVersion: '1.0.0',
      url: REPO,
      documentation: DOCS_URL,
      description,
    },
  ]}
>
    <div id="root">
      <div style="display: flex; flex-direction: column; align-items: center; overflow: clip;">
        <Nav />
        <main style="width: 100%; display: flex; flex-direction: column; align-items: center; margin-top: 1px; gap: var(--section-gap);">
          <Hero />
          <Why />
          <Metrics />
          <Features />
        </main>
        <Footer />
      </div>
    </div>
</Base>
