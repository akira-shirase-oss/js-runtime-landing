---
import SectionHeading from './ui/SectionHeading.astro'
import styles from './HowItWorks.module.css'
import { DOCS_URL } from '../data/site'

const steps = [
  {
    n: '1',
    title: 'Declare',
    text: 'A manifest names the only doors a run may use: read paths, net destinations, a KV store, a serve address. Anything not declared does not exist.',
    cite: { text: 'the manifest reference', href: `${DOCS_URL}/reference/manifest/` },
  },
  {
    n: '2',
    title: 'Run',
    text: 'V8 executes the script through deno_core. Every privileged call is a Rust op that checks the grant — a refusal is a named CapabilityError, catchable by the script itself.',
    cite: { text: 'the rt.* reference', href: `${DOCS_URL}/reference/rt-api/` },
  },
  {
    n: '3',
    title: 'Bound',
    text: 'jsrt supervise puts the worker under CPU, RSS, wall-clock and output budgets, redacts secrets and neutralises terminal escapes — then reports how it ended as JSON.',
    cite: { text: 'the supervise guide', href: `${DOCS_URL}/self-hosting/supervise/` },
  },
]
---

<section class="section" id="how-it-works">
  <div class={`container ${styles.inner}`}>
    <SectionHeading badge="HOW IT WORKS" width={720}>
      Three parts, <span class="soft">one contract</span>
    </SectionHeading>

    <ol class={styles.steps}>
      {
        steps.map((s) => (
          <li class={styles.step}>
            <p class={styles.stepN} aria-hidden="true">{s.n}</p>
            <h3 class="t-h4">{s.title}</h3>
            <p class={styles.text}>{s.text}</p>
            <p class={styles.cite}>
              <a class="inline-link" href={s.cite.href}>{s.cite.text}</a>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
