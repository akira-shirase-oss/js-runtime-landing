---
import SectionHeading from './ui/SectionHeading.astro'
import styles from './Proof.module.css'
import { REPO, DOCS_URL, CHANGELOG_URL } from '../data/site'

// Every number here is the release's own committed evidence: v1.0.0's full-scale CI load run (workflow
// load.yml, ubuntu-24.04, a 4-core Xeon 8573C runner) at commit 8dc8d32, 2026-11-19. Each card links the
// artifact that recorded it under perf/results/; the load matrix describes the whole set.
const artifact = (f: string) => `${REPO}/blob/main/perf/results/${f}`
const stats = [
  {
    n: '1,000,000',
    unit: 'of 1,000,000 refusals classified',
    text: 'every ungated op call in one ungranted run refused, and every refusal a named CapabilityError — nothing slipped through unclassified, in 6.7 s.',
    how: 'the refusal-flood scenario',
    cite: { text: 'the recorded run', href: artifact('m8-3-refusal-flood-2026-11-19T00-45-56Z-8dc8d32.json') },
  },
  {
    n: '1,000,000',
    unit: 'requests served',
    text: 'every GET answered ok through rt.serve at 75,148 rps (p50 424 µs, 32 keep-alive connections); at 128 the listener saturated flat at 76,619 rps — latency queued, nothing collapsed, zero errors.',
    how: 'the serve and saturation scenarios',
    cite: { text: 'the recorded run', href: artifact('m7-2b-serve-1m-2026-11-19T00-33-45Z-8dc8d32.json') },
  },
  {
    n: '1,000',
    unit: 'supervised respawns',
    text: 'spawn→ready→SIGTERM cycles of a serve worker, each classified exit 6 (operator-sigterm) with zero orphans — and the forwarded-output report stayed bounded by rotating a generation.',
    how: 'the supervise-churn scenario',
    cite: { text: 'the recorded run', href: artifact('m8-4-supervise-churn-2026-11-19T00-47-21Z-8dc8d32.json') },
  },
  {
    n: '51.5 ns',
    unit: 'an op call',
    text: 'a million rt.now() calls in 74.4 ms of wall time; about 47 ns of it is the Rust-to-V8 boundary after the loop baseline.',
    how: 'the op-boundary scenario',
    cite: { text: 'the recorded run', href: artifact('m7-2a-op-1m-2026-11-19T00-33-32Z-8dc8d32.json') },
  },
]
const contract = [
  ['0', 'ok'],
  ['2', 'usage'],
  ['3', 'load'],
  ['4', 'syntax'],
  ['5', 'exception'],
  ['6', 'terminated'],
  ['7', 'capability'],
  ['8', 'host'],
]
---

<section class="section" id="proof">
  <div class={`container ${styles.inner}`}>
    <SectionHeading badge="THE PROOF" width={760}>
      Measured, <span class="soft">not claimed</span>
    </SectionHeading>
    <p class={`t-body ${styles.lede}`}>
      v1.0.0 shipped 2026-11-19 (<a class="inline-link" href={CHANGELOG_URL}>the changelog</a>). Its load
      evidence is committed next to the code: the numbers below all come from the release's own CI run —
      <a class="inline-link" href={`${REPO}/blob/main/perf/LOAD_MATRIX.md`}>the load matrix</a> — on a
      4-core Xeon 8573C Linux runner at commit 8dc8d32.
    </p>

    <ul class={styles.grid} data-proof>
      {
        stats.map((s, i) => (
          <li class={styles.card} style={`--i: ${i}`}>
            <p class={styles.number}>{s.n}</p>
            <p class={`t-label ${styles.unit}`}>{s.unit}</p>
            <p class={styles.text}>{s.text}</p>
            <p class={styles.how}>
              Measured by {s.how} — <a class="inline-link" href={s.cite.href}>{s.cite.text}</a>
            </p>
          </li>
        ))
      }
    </ul>

    <div class={styles.contract}>
      <p class={`t-label ${styles.contractTitle}`}>Every way a run ends has a class and a code</p>
      <ul class={styles.codes}>
        {contract.map(([code, name]) => (
          <li class={styles.code}>
            <span class={styles.codeN}>{code}</span>
            <span class={styles.codeName}>{name}</span>
          </li>
        ))}
      </ul>
      <p class={styles.how}>
        The full contract, with each failure demoed live —{' '}
        <a class="inline-link" href={`${DOCS_URL}/reference/cli/`}>the CLI reference</a>
      </p>
    </div>

    <p class={styles.note}>
      One reproducible CI environment, not production capacity — the load matrix's own honesty rule. Failed
      runs are kept in the same directory, not re-run to a nicer number.
    </p>
  </div>
</section>

<script>
  // Same once-only entrance as the cards above it.
  const grid = document.querySelector<HTMLElement>('[data-proof]')!
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    grid.dataset.reveal = 'pending'
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          grid.dataset.reveal = 'shown'
          io.disconnect()
        }
      },
      { threshold: 0.15 },
    )
    io.observe(grid)
  }
</script>
