---
import ArrowButton from './ui/ArrowButton.astro'
import Badge from './ui/Badge.astro'
import Capabilities from './hero/Capabilities.astro'
import RunCard from './hero/RunCard.astro'
import ExitCodes from './hero/ExitCodes.astro'
import { hero } from '../data/hero'
import { REPO, DOCS_URL } from '../data/site'
import styles from './Hero.module.css'

// The hero, after the reference: a badge, the two-line statement, one line under it, two calls, a proof line,
// then three panels that each let a visitor touch one idea (grants, a run's events, the exit contract).
const LOAD_RUN = `${REPO}/blob/main/perf/results/m8-3-refusal-flood-2026-11-19T00-45-56Z-8dc8d32.json`
---

<section class={styles.hero}>
  <div class={styles.intro}>
    <Badge>Open source · v1.0.0 · Rust + V8</Badge>
    <h1 class={`t-hero ${styles.headline}`}>{hero.headline}</h1>
    <p class={styles.sub}>{hero.sub}</p>
    <div class={styles.actions}>
      <ArrowButton href={REPO} variant="outline" arrow={false}>View on GitHub</ArrowButton>
      <ArrowButton href={`${DOCS_URL}/quick-start/`}>Get started</ArrowButton>
    </div>
    <p class={styles.proof}>
      <strong>1,000,000 of 1,000,000</strong>
      <span class={styles.ticks} aria-hidden="true">{Array.from({ length: 5 }, () => <i />)}</span>
      refusals classified in <a href={LOAD_RUN} class="inline-link">v1.0.0's CI load run</a>
    </p>
  </div>
  <div class={styles.cards}>
    <Capabilities />
    <RunCard />
    <ExitCodes />
  </div>
</section>
