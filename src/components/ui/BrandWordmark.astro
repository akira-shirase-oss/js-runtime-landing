---
/** The oversized "jsrt" at the foot of every page, set in Geist Pixel's own cells (wordmark-cells.ts,
 * generated from the shipped font): every cell of the pixel type is really there. Decorative: the name
 * is already in the footer. The first time the footer comes into view it prints from the top down,
 * row by row (Footer.astro's script arms it; still without JavaScript or when motion is reduced). */
import { wordmark } from './wordmark-cells'

type Props = { class?: string }
const { class: className } = Astro.props
---

<svg
  class={className}
  viewBox={`0 0 ${wordmark.width} ${wordmark.height}`}
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
  data-wordmark
  style={`--rows: ${wordmark.capRows + 1}`}
>
  <path class="cells" d={wordmark.path} style="fill: var(--c-wordmark)"></path>
</svg>

<style>
  /* Phones: the cells are a few pixels wide and the gap a fraction of one, so let it blend rather than snap. */
  @media (max-width: 809px) {
    svg {
      shape-rendering: geometricPrecision;
    }
  }
  /* Printing: the rows appear from the top, in steps, once. */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-wordmark][data-print='armed']) {
      clip-path: inset(0 0 100% 0);
    }
    :global([data-wordmark][data-print='go']) {
      animation: print var(--print-line) steps(var(--rows), end) both;
    }
  }
</style>
