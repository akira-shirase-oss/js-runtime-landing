---
/** The section badge: a pill with the jsrt mark in amber, then a short label (the slot). */
---

<span class="badge">
  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"
    ><rect x="8" y="6" width="48" height="52" rx="8" fill="none" stroke="currentColor" stroke-width="7"></rect><path
      d="M20 22h24M20 32h24M20 42h14"
      fill="none"
      stroke="currentColor"
      stroke-width="7"
      stroke-linecap="round"></path></svg
  >
  <slot />
</span>
