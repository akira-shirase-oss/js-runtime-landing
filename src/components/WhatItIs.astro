---
import SectionHeading from './ui/SectionHeading.astro'
import styles from './WhatItIs.module.css'

// strong dots carry a ring, soft ones are lighter and smaller
type Tone = 'blue' | 'green' | 'pink' | 'blueSoft' | 'pinkSoft'

// Every claim here is in the product's docs today (concepts, the manifest and CLI references, supervise).
const cards: { title: string; lines: [string, string]; tag: string; tone: Tone; icon: string }[] = [
  {
    title: 'Deny by default',
    lines: ['A script can only do what its manifest declares.', 'No manifest: compute and print, and nothing else.'],
    tag: 'Capabilities',
    tone: 'blue',
    icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    title: 'Every ending classified',
    lines: ['A timeout, a thrown error and a refusal are different things.', 'Each has its own HostError class and its own exit code.'],
    tag: 'Honest errors',
    tone: 'green',
    icon: '<path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>',
  },
  {
    title: 'A real process boundary',
    lines: ['jsrt supervise wraps the worker in CPU, RSS, wall-clock and output budgets.', 'Secrets are redacted and terminal escapes neutralised on forwarded output.'],
    tag: 'Supervision',
    tone: 'pink',
    icon: '<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9"/><path d="M9 1v3"/><path d="M15 1v3"/><path d="M9 20v3"/><path d="M15 20v3"/><path d="M20 9h3"/><path d="M20 14h3"/><path d="M1 9h3"/><path d="M1 14h3"/>',
  },
  {
    title: 'The engine is borrowed',
    lines: ['V8 executes the script through deno_core, the crate Deno builds on.', 'The Rust host owns the grants, the lifecycle and the error classes.'],
    tag: 'V8 inside',
    tone: 'blueSoft',
    icon: '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>',
  },
]
---

<section class="section" id="what-it-is">
  <div class={`container ${styles.inner}`}>
    <SectionHeading badge="WHAT IT IS" width={720}>
      A host that owns<br />the <span class="soft">important parts</span>
    </SectionHeading>

    <ul class={styles.grid} data-why>
      {
        cards.map((c, i) => (
          <li class={styles.card} style={`--i: ${i}`}>
            <div class={styles.titleRow}>
              <span class={styles.icon} aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="30"
                  height="30"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={c.icon}
                />
              </span>
              <h3 class="t-h4">{c.title}</h3>
            </div>
            <p class={styles.body}>
              <span>{c.lines[0]}</span> <span>{c.lines[1]}</span>
            </p>
            <span class={`${styles.tag} ${styles[c.tone]}`}>
              <span class={styles.dot} aria-hidden="true" />
              {c.tag}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Micro-interaction: cards rise in, staggered, the first time the grid scrolls into view.
  // Progressive enhancement only: 'pending' (the hidden start, gated on html.js) is applied solely
  // to a grid that is still below the fold and will actually be revealed — a grid already in the
  // viewport is marked shown at once, and without JavaScript or with reduced motion nothing ever hides.
  const grid = document.querySelector<HTMLElement>('[data-why]')!
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    if (grid.getBoundingClientRect().top < window.innerHeight) {
      grid.dataset.reveal = 'shown'
    } else {
      grid.dataset.reveal = 'pending'
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            grid.dataset.reveal = 'shown'
            io.disconnect()
          }
        },
        { threshold: 0.15 },
      )
      io.observe(grid)
    }
  }
</script>
