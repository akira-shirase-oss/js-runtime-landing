---
import styles from './More.module.css'
import { REPO, DOCS_URL, CHANGELOG_URL } from '../data/site'

// The three doors off the page: the docs and the changelog live on the docs site, the code and its
// evidence live on GitHub.
const cards = [
  {
    title: 'The docs',
    text: 'The quick start, the rt.* reference, the capability manifest and the exit-code contract.',
    href: DOCS_URL,
    icon: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  },
  {
    title: 'The changelog',
    text: 'What shipped and when — v1.0.0 is the first release, written to teach, newest first.',
    href: CHANGELOG_URL,
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  },
  {
    title: 'GitHub',
    text: 'The Rust source, the issue tracker and the committed load evidence in perf/.',
    href: REPO,
    icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>',
  },
]
---

<section class="section" id="more">
  <div class={`container ${styles.inner}`}>
    <ul class={styles.grid}>
      {
        cards.map((c) => (
          <li>
            <a class={styles.card} href={c.href}>
              <span class={styles.icon} aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="26"
                  height="26"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={c.icon}
                />
              </span>
              <span class={styles.body}>
                <span class={`t-h5 ${styles.title}`}>{c.title}</span>
                <span class={styles.text}>{c.text}</span>
              </span>
              <span class={styles.go} aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
