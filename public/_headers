# Security headers for every response from Cloudflare Pages
# (syntax: https://developers.cloudflare.com/pages/configuration/headers/).
# `npm run build && npm run check` fails if a header is missing or the policy no longer fits the pages.
#
# Content-Security-Policy, one directive at a time:
#   default-src 'none'   nothing loads unless a directive below allows it
#   script-src           same-origin files plus the SHA-256 of each inline <script> Astro emits. When a
#                        component script changes, the check prints the new hash: review the script, then
#                        swap the hash here. JSON-LD blocks are data, not scripts, so they need none.
#   style-src            'unsafe-inline' because Astro inlines small stylesheets and components set
#                        style attributes. Adding a hash here would switch 'unsafe-inline' off.
#   img-src, font-src    the site's own files only: images and fonts are self-hosted
#   base-uri, form-action, frame-ancestors   'none': no <base>, no forms, never framed
# Cloudflare Web Analytics auto-injection, Rocket Loader and Zaraz add scripts this policy blocks.
# Leave them off, or change the policy first.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-fx/Ld28B18wLa0D9x6mIwT7q87VdSk5MgxtORpQdXR8=' 'sha256-Hvfl2Jeob5z2TDEhzda+e66iK/YlTu03/IpkpfUEZsQ=' 'sha256-MlJReUqnGLWdXioB1aQwIlWSi28TiFv6/H0A4IdzEZ0=' 'sha256-KWkIV3YekngMXEB1NVr2N76TudcFOrSSOAXys1/TMPY=' 'sha256-5B0hmfXYyPk/bN+7hhR/ZvN7B2A0vuED3n1yTk2oneQ=' 'sha256-WyQr/h4E+zh6gLbvnnll/4WJa/hgmspt0AxDyeBQ1p0=' 'sha256-ZVOlaHTzKWn0aw/7SlZpzUC33YyUIXuq0yXJ4oNhCNE='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
